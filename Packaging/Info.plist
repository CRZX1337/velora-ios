	<string>Velora uses your location to measure speed and distance during an active trip. Your location is processed locally on your device.</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
