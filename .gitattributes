# Text normalisation. PowerShell keeps CRLF in the working tree because the
# build and test scripts target Windows tooling.

* text=auto eol=lf

*.swift text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.xcprivacy text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
